{
  "expo": {
    "name": "MOTA",
    "slug": "mota",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mota-icon-white.png",
    "scheme": "mota",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tiangroupinnovation.mota",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MOTA uses your location to find nearby rides, show drivers and passengers on the map, and track an active ride.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.tiangroupinnovation.mota",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/mota-icon-black.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/images/mota-icon-white.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/official-mota-black-logo-removebg-preview.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c503fc3c-650c-4f52-93ee-c6c151e28fb3"
      }
    },
    "owner": "tiangroupinnovation"
  }
}
