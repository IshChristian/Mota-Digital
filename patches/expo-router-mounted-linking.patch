+"use strict";
+const React = require("react");
+// Initial URL resolution can finish while React is still rendering/suspending.
+// Store that result without dispatching until this navigation container commits.
+function useMountedLinkingCallback(callback) {
+    const mounted = React.useRef(false);
+    const pending = React.useRef(null);
+    const latest = React.useRef(callback);
+    React.useEffect(() => { latest.current = callback; }, [callback]);
+    React.useEffect(() => {
+        mounted.current = true;
+        if (pending.current !== null) {
+            const value = pending.current.value;
+            pending.current = null;
+            latest.current(value);
+        }
+        return () => { mounted.current = false; };
+    }, []);
+    return React.useCallback((value) => {
+        if (mounted.current) latest.current(value);
+        else pending.current = { value };
+    }, []);
+}
+exports.useMountedLinkingCallback = useMountedLinkingCallback;
